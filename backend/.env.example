# Plantilla de configuracion de server.py y visor.py. Copiar a backend/.env y llenar.
# backend/.env NO se versiona (CLAUDE.md, seccion 5). Aqui no van valores reales.

# --- Neo4j (server.py, poolling.py, reporte4.py) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Secreto HMAC compartido entre visor.py y server.py ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
API_SECRET=

# --- visor.py: URL del servidor central ---
# Por defecto http://localhost:26998. En la PC del aula (produccion):
#   SERVER_URL=https://prueba.almxlvx.com
SERVER_URL=http://localhost:26998

# --- server.py: origenes de navegador que pueden abrir Socket.IO ---
# Lista separada por comas. Es el origen con que el navegador del aula abre la
# pagina del QR que sirve visor.py. Si el proyector abriera el visor desde otra
# maquina (p. ej. http://10.0.0.15:5555), ese origen tiene que agregarse aqui.
SOCKETIO_CORS_ORIGINS=http://localhost:5555,http://127.0.0.1:5555

# --- server.py: atributo Secure de la cookie user_tracker ---
# 1 (por defecto) en produccion. 0 solo para probar el formulario web por http
# fuera de localhost.
COOKIE_SECURE=1
