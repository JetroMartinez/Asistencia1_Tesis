<?xml version="1.0" encoding="utf-8"?>
<!--
    Politica de red SOLO para debug: permite HTTP hacia el servidor local
    (localhost via adb reverse, 10.0.2.2 desde el emulador). Este archivo no
    entra al APK release; alla rige app/src/main/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
