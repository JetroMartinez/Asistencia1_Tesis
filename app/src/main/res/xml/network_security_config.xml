<?xml version="1.0" encoding="utf-8"?>
<!--
    Politica de red de release: solo HTTPS, sin excepciones.
    El build debug la sobrescribe con app/src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
