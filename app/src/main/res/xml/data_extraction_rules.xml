<?xml version="1.0" encoding="utf-8"?><!--
   Reglas de respaldo y transferencia para API 31+.
   La sesion cifrada y la huella de instalacion se excluyen por las mismas razones
   que en backup_rules.xml.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sesion_cifrada.xml" />
        <exclude domain="sharedpref" path="instalacion.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sesion_cifrada.xml" />
        <exclude domain="sharedpref" path="instalacion.xml" />
    </device-transfer>
</data-extraction-rules>
